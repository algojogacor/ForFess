// Schema Prisma — Fess UNAIR
//
// Prinsip privasi: server TIDAK menyimpan identitas siapa pun.
// Model di sini hanya mencatat interaksi anonim agregat (reaksi pembaca),
// tanpa IP, tanpa cookie, tanpa token apa pun.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Satu reaksi pembaca pada satu kartu menfess.
/// Baris dibuat anonim: yang disimpan cuma ID media IG-nya, jenis reaksi,
/// dan waktu. Anti-spam dilakukan rate-limit in-memory per IP — IP-nya
/// sendiri tidak pernah ditulis ke database.
model FessReaction {
  id        String   @id @default(cuid())
  /// ID media Instagram (angka, lihat validasi di lib/reaksi.ts).
  mediaId   String
  /// Jenis reaksi — salah satu nilai REACTION_KINDS (lib/konstanta).
  kind      String
  createdAt DateTime @default(now())

  // Pola baca utama: hitung per kartu per jenis.
  @@index([mediaId, kind])
  // Pola baca sekunder: buang baris tua saat maintenance.
  @@index([createdAt])
}

/// Sesi aktif anonim untuk counter "xx mahasiswa sedang online".
/// Sesi berupa UUID acak sementara di sessionStorage browser pengunjung,
/// tanpa IP, tanpa cookie pelacak, dan otomatis dibersihkan jika > 5 menit.
model ActiveSession {
  id        String   @id
  lastSeen  DateTime @default(now())

  @@index([lastSeen])
}
